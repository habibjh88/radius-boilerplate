{
  "name": "radius-boilerplate",
  "version": "1.0.0",
  "description": "WordPress plugin boilerplate — React 19 + Tailwind + shadcn/ui admin, built with @wordpress/scripts.",
  "author": "RadiusTheme",
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "start": "wp-scripts start",
    "build": "wp-scripts build",
    "lint:js": "wp-scripts lint-js src",
    "lint:js:fix": "wp-scripts lint-js src --fix",
    "format": "wp-scripts format src",
    "packages-update": "wp-scripts packages-update",
    "package": "bash ./bin/build-plugin-zip.sh",
    "i18n:pot": "wp i18n make-pot . languages/radius-boilerplate.pot --domain=radius-boilerplate --exclude=node_modules,build,vendor,tests",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean",
    "env:destroy": "wp-env destroy",
    "composer": "wp-env run cli --env-cwd=wp-content/plugins/radius-boilerplate composer",
    "test:php": "wp-env run phpunit 'phpunit -c /var/www/html/wp-content/plugins/radius-boilerplate/phpunit.xml.dist --verbose'",
    "test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.ts",
    "test:e2e:ui": "wp-scripts test-playwright --ui --config tests/e2e/playwright.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-table": "^8.21.3",
    "@wordpress/api-fetch": "^7.6.0",
    "@wordpress/block-editor": "^14.6.0",
    "@wordpress/blocks": "^13.6.0",
    "@wordpress/components": "^28.6.0",
    "@wordpress/data": "^10.6.0",
    "@wordpress/element": "^6.6.0",
    "@wordpress/hooks": "^4.32.0",
    "@wordpress/i18n": "^5.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.30.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@wordpress/e2e-test-utils-playwright": "^1.17.0",
    "@wordpress/env": "^10.17.0",
    "@wordpress/scripts": "^30.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7"
  }
}
